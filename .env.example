# All integrations are disabled until explicitly configured. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=https://venizor.com
# Set for a non-Vercel production deployment; Vercel uses VERCEL_ENV automatically.
SITE_INDEXABLE=false
SITE_CONTENT_UPDATED_AT=2026-10-18T00:00:00Z
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Business details deferred; empty values render no invented identity or contact channel.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CAL_LINK=

# Enable only after the sender domain, recipient, Turnstile and Redis are verified.
NEXT_PUBLIC_CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=venizor.com,www.venizor.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
CRON_SECRET=
# Separate destinations for explicit synthetic delivery tests.
SYNTHETIC_CONTACT_SECRET=
CONTACT_TEST_TO_EMAIL=
CRM_TEST_WEBHOOK_URL=

# Monitoring and analytics remain disconnected. Analytics requires visitor opt-in.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
